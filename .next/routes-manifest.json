      "routeKeys": {},
      "namedRegex": "^/api/compiler(?:/)?$"
    },
    {
      "page": "/api/compiler/interactive",
      "regex": "^/api/compiler/interactive(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/compiler/interactive(?:/)?$"
    },
    {
      "page": "/api/compiler/token",
      "regex": "^/api/compiler/token(?:/)?$",
