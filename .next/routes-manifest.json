    },
    {
      "page": "/api/knowledge",
      "regex": "^/api/knowledge(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/knowledge(?:/)?$"
    },
    {
      "page": "/api/knowledge/learn",
      "regex": "^/api/knowledge/learn(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/knowledge/learn(?:/)?$"
    },
    {
      "page": "/api/liveblocks-auth",
      "regex": "^/api/liveblocks\\-auth(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/liveblocks\\-auth(?:/)?$"
    },
    {
      "page": "/api/profile",
      "regex": "^/api/profile(?:/)?$",
      "routeKeys": {},
